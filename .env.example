# Template for /home/cx/论文/.env — copy to .env and fill real values.
# .env is in .gitignore; .env.example is tracked so collaborators know what's needed.
#
# All scripts read these via os.environ.get(...) — see
# .trae/skills/*/resources/*.py and bootstrap_*.py

# Semantic Scholar API key
# Free, request at https://www.semanticscholar.org/product/api#api-key
# Without key: ~100 req/5min. With key: ~1 req/sec (much faster for bulk retrieval).
S2_API_KEY=

# Crossref polite-pool email (optional)
# Provide a real email to enter Crossref's polite pool: faster, more reliable.
# Used by .trae/skills/fact-checking-citations/resources/crossref_verify.py
CROSSREF_MAILTO=
